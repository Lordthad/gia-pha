  "version": 1,
  "dongHo": {
    "ten": "Gia phả dòng họ Lê Duy - Làng Đại Bái",
    "quyUocXungHo": "bac",
    "maQuanTri": {
      "muoi": "5nzKJi7kNGKN8/xmcMKPYQ==",
      "bam": "8NSGsMvPOkhpDrpSczbOG9OBHd23UmcxshKH1U+GcUw=",
      "vong": 250000
    },
    "loiTua": "Chim có tổ, người có tông. Cây có gốc mới nở cành xanh ngọn, nước có nguồn mới bể rộng sông sâu.\n\nDòng họ Lê Duy ta khởi từ cụ thuỷ tổ Lê Duy Loan, lập nghiệp ở làng Đại Bái tỉnh Thanh Hóa. Trải bao đời, con cháu người ở lại quê cha đất tổ, người tha phương lập nghiệp bốn phương trời, nhưng cùng chung một gốc, cùng thờ một tổ.\n\nXưa việc họ chép trong cuốn sổ tay, giấy mực có hạn, chữ nghĩa mai một dần, người sau muốn tra cứu lắm khi không biết hỏi ai. Nay chép lại vào bản gia phả này, để tên tuổi, ngày giỗ, phần mộ các cụ được lưu giữ lâu dài; để con cháu dù ở đâu, mở máy ra là biết mình thuộc đời thứ mấy, gặp người trong họ thì biết đường xưng hô cho phải phép.\n\nGia phả là việc chung của cả họ, không phải của riêng ai. Bản này chắc còn khiếm khuyết, kính mong các bậc cao niên chỉ bảo, con cháu các chi bổ sung thêm vào, để mỗi ngày một đầy đủ hơn.\n\nKính cáo tổ tiên.\n\nLê Duy Ngân — tháng 8 năm 2026",
    "thuyToId": "P001"
  },
